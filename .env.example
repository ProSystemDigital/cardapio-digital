# O MVP do cardápio não exige variáveis de ambiente.
# Adicione somente nomes de variáveis públicas ou placeholders sem credenciais.
CATALOG_REPOSITORY=memory
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORTA/BANCO

# Autenticação administrativa local. Nunca preencha valores reais neste arquivo.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/sign-up

# Stripe Billing sandbox. Segredos nunca devem ser preenchidos neste arquivo versionado.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_ESSENTIAL_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=
# Obrigatório antes de ativar provisionamento por webhook.
STRIPE_WEBHOOK_SECRET=

# Token exclusivamente de servidor, fornecido pela store Vercel Blob vinculada.
BLOB_READ_WRITE_TOKEN=

# Fixtures funcionam somente fora de produção. Use `disabled` para ocultar o laboratório local.
DELIVERY_COVERAGE_PROVIDER=local_fixtures

# Credencial exclusivamente de servidor para futuro sandbox geográfico. Nunca use no navegador.
GEOAPIFY_API_KEY=

# Identidade profissional pública da plataforma; configure somente com canal existente e monitorado.
PLATFORM_LEGAL_NAME=
PLATFORM_PRIVACY_EMAIL=

# Referência interna do parecer/aprovação final; preencher somente após revisão humana real.
DELIVERY_PRIVACY_APPROVAL_REFERENCE=
DELIVERY_PRIVACY_APPROVAL_DATE=
