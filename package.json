{
  "name": "cardapio-digital",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "playwright test --config=playwright.unit.config.ts",
    "test:database": "playwright test --config=playwright.database.config.ts",
    "test:visual": "npm run build && playwright test",
    "test:visual:existing-build": "playwright test",
    "test:pwa": "npm run build && playwright test --config=playwright.pwa.config.ts",
    "test:pwa:existing-build": "playwright test --config=playwright.pwa.config.ts",
    "test:visual:headed": "npm run build && playwright test --headed",
    "test:visual:ui": "npm run build && playwright test --ui",
    "test:visual:report": "playwright show-report"
  },
  "dependencies": {
    "@fontsource/open-sauce-sans": "^5.3.0",
    "@serwist/next": "^9.5.12",
    "next": "^16.2.11",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "sass": "^1.77.0",
    "serwist": "^9.5.12",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
